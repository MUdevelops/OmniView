{
  "name": "omniview",
  "private": true,
  "version": "1.0.0",
  "description": "View-only universal file viewer. 100% client-side: files never leave the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests config",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/make_fixtures.py",
    "postinstall": "node scripts/copy-gs.mjs"
  },
  "dependencies": {
    "ag-psd": "28.2.0",
    "docx-preview": "0.3.3",
    "dompurify": "3.1.7",
    "exifr": "7.1.3",
    "fflate": "0.8.2",
    "libheif-js": "1.18.2",
    "pdfjs-dist": "4.6.82",
    "pptx-preview": "1.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "utif2": "4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "4.5.5"
  },
  "optionalDependencies": {
    "@jspawn/ghostscript-wasm": "0.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@playwright/test": "1.48.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@types/dompurify": "3.0.5",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.12.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.1",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.2"
  }
}
